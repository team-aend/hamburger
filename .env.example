# 루트 .env 예시 (docker compose 가 자동으로 읽는다)
# 실제 값이 담긴 .env 는 커밋하지 않는다.

# 팀 공용 Supabase 접속 URI (Supabase 대시보드 > Settings > Database)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# 로컬 Postgres 컨테이너를 쓸 때 (docker compose --profile local-db)
# DATABASE_URL="postgresql://postgres:postgres@db:5432/hamburger"

CORS_ORIGIN=http://localhost:3000
