PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Connection URI (Session Pooler)
# backend/.env 파일을 생성하고 [YOUR-PASSWORD] 부분에 DB 비밀번호를 입력하세요.
# (비밀번호에 !, @ 등 특수문자가 포함된 경우 URL 인코딩 처리 필요: ! -> %21, @ -> %40)
#
# 직접 접속 주소(db.<project-ref>.supabase.co)는 IPv6 전용이라 IPv4 네트워크에서는
# getaddrinfo ENOTFOUND 로 접속되지 않는다. IPv4를 지원하는 Pooler 주소를 사용한다.
# (사용자명이 postgres 가 아니라 postgres.<project-ref> 형식인 점에 주의)
# 포트 6543 = Transaction Pooler (트랜잭션 모드). 5432(Session Pooler)는 동시 연결이 15개뿐인데
# 백엔드 서버 하나가 연결을 최대 15개까지 잡고 있어서(pool.ts max: 15), 팀원 서버·QA 서버가 함께 켜지면
# "max clients reached" 로 접속이 막힌다. 6543은 여러 서버가 같이 붙어도 괜찮다.
# (트랜잭션·pg_advisory_xact_lock 은 6543에서도 정상 동작 확인, 2026-10-31)
DATABASE_URL="postgresql://postgres.lyjsyiguasujjdsltjem:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# ── 로그인 (Google OAuth) ──
# 세션 쿠키 서명용 비밀값 (32자 이상 랜덤 문자열)
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
#   승인된 리디렉션 URI 에 GOOGLE_REDIRECT_URI 와 똑같은 값을 등록한다.
#   (프론트 3000 포트의 /api 프록시를 거치므로 3000 포트 주소를 쓴다 → 쿠키가 프론트 도메인에 저장됨)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 개발용 테스트 로그인: true 면 로그인 화면에 "테스트 계정으로 로그인" 버튼이 생긴다.
# Google 설정 없이 로그인 기능을 테스트할 때만 사용. NODE_ENV=production 에서는 항상 꺼진다.
DEV_LOGIN=false
